# PostgreSQL
PG_PASSWORD=talentos_dev_secret
DATABASE_URL=postgres://talentos:${PG_PASSWORD}@localhost:5432/talentos
# BYPASSRLS role, login/refresh only (created by scripts/init-db.sql)
DATABASE_AUTH_URL=postgres://talentos_auth:auth_dev_secret@localhost:5432/talentos

# Kafka
KAFKA_BROKERS=localhost:9092

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=talentos-dev

# Redis
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# MinIO (object storage for payslips, attachments)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=talentos_minio
MINIO_SECRET_KEY=minio_dev_secret
MINIO_BUCKET=talentos-files

# AI Model Gateway (huakati.online — OpenAI-compatible)
HUAKATI_API_BASE=https://llmapi.huakati.online/v1
HUAKATI_API_KEY=sk-your-key-here
HUAKATI_MODEL=qwen2.5-72b-instruct

# Application
RUST_LOG=talentos=debug,tower_http=info
APP_ENV=development
AUTH_JWT_SECRET=change-me-in-production-min-32-chars
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_PORT=8080
DB_MAX_CONNS=10