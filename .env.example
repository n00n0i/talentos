# PostgreSQL
# Migrations run as the owner (talentos). The gateway must run as talentos_app:
# it is NOBYPASSRLS, so RLS actually applies. Using the owner at runtime silently
# disables every tenant policy.
PG_PASSWORD=talentos_dev_secret
APP_DB_PASSWORD=app_dev_secret
AUTH_DB_PASSWORD=auth_dev_secret
DATABASE_URL=postgres://talentos_app:${APP_DB_PASSWORD}@localhost:5432/talentos
DATABASE_ADMIN_URL=postgres://talentos:${PG_PASSWORD}@localhost:5432/talentos
# BYPASSRLS role, login/refresh only (created by scripts/init-db.sql)
DATABASE_AUTH_URL=postgres://talentos_auth:auth_dev_secret@localhost:5432/talentos

# Kafka
KAFKA_BROKERS=localhost:9092

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=talentos-dev

# Redis
REDIS_PASSWORD=redis_dev_secret
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# MinIO (object storage for payslips, attachments)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=talentos_minio
MINIO_SECRET_KEY=minio_dev_secret
MINIO_BUCKET=talentos-files

# AI Model Gateway (huakati.online — OpenAI-compatible)
HUAKATI_API_BASE=https://llmapi.huakati.online/v1
HUAKATI_API_KEY=sk-your-key-here
HUAKATI_MODEL=qwen2.5-72b-instruct

# Application
RUST_LOG=talentos=debug,tower_http=info
APP_ENV=development
AUTH_JWT_SECRET=change-me-in-production-min-32-chars
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_DAYS=7
AUTH_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_PORT=8080
# Payslip PDF rendering (headless Chromium + Thai fonts required)
CHROME_BIN=chromium-browser
PAYSLIP_STORE_DIR=./data/payslips
# A payroll run stuck in 'calculating' longer than this is re-executed
PAYROLL_STUCK_AFTER_SECS=600
DB_MAX_CONNS=10
# PII at rest (64 hex chars: `openssl rand -hex 32`). Required in production;
# without it new national id / SSO / bank values are stored as plaintext.
PII_ENCRYPTION_KEY=
# Optional bearer token required by GET /metrics; leave blank to allow the
# scrape endpoint on the private network.
METRICS_TOKEN=
# Public URL of the app (used for CORS + cookie choices)
APP_URL=http://localhost
TALENTOS_COOKIE_SECURE=false

# Notifications (optional; leave blank to disable the channel)
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_BASE=https://api.resend.com
LINE_CHANNEL_TOKEN=
LINE_API_BASE=https://api.line.me

# PF remittance provider (both required to enable the "ส่ง PF" flow)
PF_API_BASE=
PF_API_TOKEN=
